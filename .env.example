# Persistent PostgreSQL connection string for production on Vercel (Neon / Supabase / Vercel Postgres)
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Comma-separated frontend origins allowed by CORS (e.g. https://kharch-karod.vercel.app)
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app

# Signing secret for JWT tokens
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Optional: Gemini API key for sanitized merchant enrichment and KHARCH AI phrasing
GEMINI_API_KEY=
